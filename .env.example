DB_USERNAME=talleres360
DB_PASSWORD=
INTERNAL_API_KEY=
# Sin SMTP real no se marcan correos como enviados.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Activar cuando exista RabbitMQ; no se incluye el clúster en este repositorio.
RABBIT_ENABLED=false
RABBIT_HOST=
RABBIT_PORT=5672
RABBIT_USERNAME=
RABBIT_PASSWORD=
RABBIT_VHOST=/
RABBIT_EMAIL_QUEUE=q.cmd.email
RABBIT_WORKSHOP_QUEUE=q.cmd.workshop
