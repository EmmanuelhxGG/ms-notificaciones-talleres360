DB_USERNAME=talleres360
DB_PASSWORD=
INTERNAL_API_KEY=
# Sin SMTP real no se marcan correos como enviados.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Credencial del proveedor del REMITENTE. No corresponde al destinatario @duocuc.cl.
# No pegar aquí la contraseña normal de los clientes.
SMTP_FROM=
SMTP_AUTH=true
SMTP_STARTTLS=true
# El clúster independiente de dos nodos está en infra/mq.
RABBIT_ENABLED=true
# false conserva las cartas muertas en Management para inspección como en la guía.
# true las archiva en mensajes_fallidos y confirma su recepción.
RABBIT_DLQ_AUTO_STARTUP=true
RABBIT_ADDRESSES=IP_PRIVADA_EC2_MQ:5672,IP_PRIVADA_EC2_MQ:5673
RABBIT_HOST=
RABBIT_PORT=5672
RABBIT_USERNAME=
RABBIT_PASSWORD=
RABBIT_VHOST=/
# Nombres, rutas y bindings: config/TopologiaRabbit.java (app.rabbit.topologia).
RABBIT_RETRY_ATTEMPTS=3
RABBIT_RETRY_WAIT_MS=1000
